<?xml version="1.0" encoding="utf-8"?>
<!--
  Count badge on a drawer row.

  Was @color/colorPrimary, which is still the app's original amber (#f4b400)
  left over in colors.xml - a stray warm pill in an otherwise cyan-and-ink
  drawer. Uses the theme accent now, and its label takes somaOnFill to match.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/somaPrimary"/>
    <corners android:radius="12dp"/>
</shape>

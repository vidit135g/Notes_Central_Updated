<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed twin of bg_card.xml, used only by in-app (Activity-context) layouts.
  Kept separate from bg_card.xml on purpose: that one is also inflated by the
  home-screen widget's RemoteViews (an un-themed context), and Android's
  drawable ConstantState cache can share one resolved ?attr color across
  every inflation of the same resource id regardless of context - mixing
  the two caused every in-app card to render with the widget's static white
  instead of the active Soma period's color.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="?attr/somaElev" />
    <stroke
        android:color="?attr/somaBorderSub"
        android:width="1dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Note card.

  Kept separate from bg_card.xml on purpose: that one is also inflated by the
  home-screen widget's RemoteViews (an un-themed context), and Android's
  drawable ConstantState cache can share one resolved ?attr colour across every
  inflation of the same resource id regardless of context - mixing the two made
  every in-app card render with the widget's static white.

  Fill is somaSurf, not somaElev. somaElev is the page itself in the light
  theme, so a card painted with it was white on white and the whole list read as
  unseparated rows of text. The old three-layer "glass" treatment (white sheen
  gradient plus a #40FFFFFF hairline) went with it: both were tuned for the dark
  dosha grounds and are invisible-to-muddy on a white page.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="?attr/somaSurf" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The identity mark: a note sheet with its top-right corner turned down, ruled
  in ink. Vector twin of the launcher icon's foreground (see mkicon_v2.py), used
  on the splash and anywhere the mark appears inside the app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Sheet, with the folded corner cut out of the top right. -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M28,18 L68,18 L90,40 L90,82 A 8 8 0 0 1 82 90 L28,90 A 8 8 0 0 1 20 82 L20,26 A 8 8 0 0 1 28 18 Z" />
    <!-- Underside of the fold. -->
    <path android:fillColor="#CBECFA"
        android:pathData="M68,18 L90,40 L68,40 Z" />

    <!-- Title rule in ink, two body rules in a tint: the heavy one still reads
         as a line of writing when the icon is 48dp. -->
    <path android:strokeColor="#0B1E26" android:strokeWidth="6.2"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M32,53 L59,53" />
    <path android:strokeColor="#A8D6E8" android:strokeWidth="6.2"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M32,66 L78,66" />
    <path android:strokeColor="#A8D6E8" android:strokeWidth="6.2"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M32,79 L68,79" />
</vector>

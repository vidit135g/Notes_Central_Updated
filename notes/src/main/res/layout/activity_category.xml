<!--
  Was a 300dp dialog-shaped column shown as a full-screen activity, which left
  the form crammed into a narrow strip above a large void. Laid out as a real
  screen now, in the same Soma language as the list and editor. Every id is
  preserved because CategoryActivity binds them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:pixlui="http://schemas.android.com/apk/com.neopixl.pixlui"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/somaBg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <com.neopixl.pixlui.components.textview.TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/soma_space_eyebrow"
        android:textSize="10sp"
        android:letterSpacing="0.14"
        android:textColor="?attr/somaTextM"
        pixlui:typeface="Poppins-Bold.ttf" />

    <com.neopixl.pixlui.components.textview.TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/soma_space_title"
        android:textSize="26sp"
        android:includeFontPadding="false"
        android:textColor="?attr/somaTextP"
        pixlui:typeface="Poppins-SemiBold.ttf" />

    <com.neopixl.pixlui.components.textview.TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/soma_space_name_label"
        android:textSize="9sp"
        android:letterSpacing="0.13"
        android:textColor="?attr/somaTextM"
        pixlui:typeface="Poppins-Bold.ttf" />

    <EditText
        android:id="@+id/category_title"
        android:background="@drawable/bg_soma_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="15dp"
        android:hint="@string/category_title"
        android:inputType="textCapSentences"
        android:textAppearance="@style/Text.Big.Soma"
        android:textColorHint="?attr/somaTextM"
        android:textColor="?attr/somaTextP"
        android:textCursorDrawable="@null" />

    <EditText
        android:id="@+id/category_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/category_description"
        android:visibility="gone" />

    <com.neopixl.pixlui.components.textview.TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/soma_space_colour_label"
        android:textSize="9sp"
        android:letterSpacing="0.13"
        android:textColor="?attr/somaTextM"
        pixlui:typeface="Poppins-Bold.ttf" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_soma_tile_surf"
        android:padding="14dp">

        <ImageView
            android:id="@+id/color_chooser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/gray_circle" />

        <com.neopixl.pixlui.components.textview.TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/soma_space_colour_hint"
            android:textSize="12.5sp"
            android:textColor="?attr/somaTextS"
            pixlui:typeface="Poppins-Regular.ttf" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:strokeColor="?attr/somaPrimaryPressed"
            android:text="@string/delete"
            android:textColor="?attr/somaPrimaryPressed"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:minWidth="130dp"
            android:text="@string/ok"
            android:textColor="?attr/somaOnFill"
            app:backgroundTint="?attr/somaPrimary"
            app:cornerRadius="15dp" />

    </LinearLayout>

</LinearLayout>

<!-- One drawer destination, in the same row language as the bottom nav. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Activated state is set by NavDrawerAdapter, which already knows which
         destination is current; the ListView's own checked state is not
         reliable here because the adapter derives selection from Navigation. -->
    <LinearLayout
        android:id="@+id/drawer_row"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_soma_drawer_row"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:tint="?attr/somaTextS" />

        <com.neopixl.pixlui.components.textview.TextView
            xmlns:pixlui="http://schemas.android.com/apk/com.neopixl.pixlui"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="?attr/somaTextP"
            pixlui:typeface="Poppins-Medium.ttf" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="22dp"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="10sp"
            android:textColor="?attr/somaOnFill"
            android:background="@drawable/category_count_bg"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Onboarding page.

  The purple ground is fixed, not themed: this is the one screen that is
  neither light nor dark, and it runs before the user has chosen a theme. Every
  colour on it is a literal from colors_soma.xml's "Onboarding only" block, so
  it looks the same whichever theme the device lands on afterwards.

  Bottom padding clears AppIntro2's own dots and next/done buttons, which are
  drawn by the host activity over this layout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:pixlui="http://schemas.android.com/apk/com.neopixl.pixlui"
    android:id="@+id/intro_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soma_intro_bg">

    <!-- Soft bubbles. Decorative only. -->
    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="-60dp"
        android:layout_marginTop="150dp"
        android:background="@drawable/bg_soma_intro_bubble" />

    <View
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_soma_intro_bubble" />

    <View
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="end"
        android:layout_marginEnd="-30dp"
        android:layout_marginTop="330dp"
        android:background="@drawable/bg_soma_intro_bubble" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="104dp">

        <com.neopixl.pixlui.components.textview.TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:letterSpacing="-0.035"
            android:includeFontPadding="false"
            android:textColor="@color/soma_light_elev"
            pixlui:typeface="Poppins-Bold.ttf" />

        <!-- Step counter, kept for orientation across three pages. -->
        <com.neopixl.pixlui.components.textview.TextView
            android:id="@+id/intro_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:alpha="0.75"
            android:textColor="@color/soma_light_elev"
            pixlui:typeface="Poppins-Bold.ttf" />

        <!-- Illustration, or on the last page the theme picker. -->
        <ImageView
            android:id="@+id/intro_illustration"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <FrameLayout
            android:id="@+id/intro_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Headline card. Near-black on cyan, as everywhere the accent is a fill. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_soma_intro_card"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <com.neopixl.pixlui.components.textview.TextView
                android:id="@+id/intro_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="27sp"
                android:letterSpacing="-0.035"
                android:lineSpacingMultiplier="1.15"
                android:includeFontPadding="false"
                android:textColor="@color/soma_intro_ink"
                pixlui:typeface="Poppins-Bold.ttf" />

            <com.neopixl.pixlui.components.textview.TextView
                android:id="@+id/intro_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.45"
                android:textColor="@color/soma_light_onFillSub"
                pixlui:typeface="Poppins-Regular.ttf" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

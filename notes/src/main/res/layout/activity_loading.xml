<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash.

  A flat accent ground with the mark and the wordmark on it, matching the
  platform splash the system draws before this Activity exists
  (Theme.Soma.Starting: same colour, same mark) so the handover between the two
  is invisible. It used to be a white-to-amber sheen sweeping diagonally under a
  themed logo, which meant the system splash and the app's own splash were two
  different screens in a row.

  Fixed colours, not theme attrs: this runs before the user's theme matters and
  the mark is white, so the ground has to be the accent in both themes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soma_splash_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/loading_logo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:src="@drawable/ic_splash_sheet"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/app_name"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="-0.035"
            android:textColor="@color/soma_intro_ink"
            android:textSize="24sp" />

    </LinearLayout>

</FrameLayout>

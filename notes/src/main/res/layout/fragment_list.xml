<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:wheel="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:pixlui="http://schemas.android.com/tools"
    android:layout_marginLeft="@dimen/activity_additional_margin"
    android:layout_marginRight="@dimen/activity_additional_margin">

    <com.absolute.android.notescentral.models.views.InterceptorLinearLayout
            android:id="@+id/list_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
        android:background="?attr/somaBg"
            android:orientation="vertical">

        <LinearLayout
                android:id="@+id/search_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:paddingLeft="@dimen/horizontal_margin"
                android:paddingStart="@dimen/horizontal_margin">

            <TextView
                    android:id="@+id/search_query"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/Text.Small"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"/>

            <ImageView
                    android:id="@+id/search_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_cancel_black_18dp"
                    android:paddingTop="10dp"
                    android:paddingRight="@dimen/horizontal_margin"
                    android:paddingEnd="@dimen/horizontal_margin"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/soma_search_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/horizontal_margin"
            android:layout_marginEnd="@dimen/horizontal_margin"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_soma_search_row"
            android:elevation="2dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_search_white_24dp"
                android:tint="?attr/somaTextM" />

            <com.neopixl.pixlui.components.textview.TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/soma_search_hint"
                android:textSize="14sp"
                android:textColor="?attr/somaTextM"
                pixlui:typeface="Poppins-Regular.ttf" />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/category_chip_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/category_chip_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/horizontal_margin"
                android:paddingEnd="@dimen/horizontal_margin" />

        </HorizontalScrollView>

        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <com.nhaarman.listviewanimations.itemmanipulation.DynamicListView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="8dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="@dimen/padding_half"
                    android:clipToPadding="false"
                    android:scrollbarSize="4dp"
                android:paddingBottom="60dp"
                    android:drawSelectorOnTop="true"
                    android:listSelector="@drawable/icon_selector"
                    android:scrollbarStyle="outsideOverlay"
                    android:scrollbarThumbVertical="@drawable/scroll_bar"
                    android:fastScrollEnabled="true"
                    android:smoothScrollbar="true"
                    android:scrollingCache="false"
                    android:animationCache="false"/>

            <LinearLayout
                    android:id="@+id/empty_state_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="70dp"
                    android:visibility="gone">

                <com.absolute.android.notescentral.models.views.SomaBreathOrbView
                    android:id="@+id/empty_list"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center" />

                <com.neopixl.pixlui.components.textview.TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/soma_empty_list_title"
                    android:textSize="17sp"
                    android:textColor="?attr/somaTextP"
                    pixlui:typeface="Fraunces-SemiBold.ttf" />

                <com.neopixl.pixlui.components.textview.TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/soma_empty_list_subtitle"
                    android:textSize="13sp"
                    android:textColor="?attr/somaTextM"
                    pixlui:typeface="Poppins-Regular.ttf" />

            </LinearLayout>




        </FrameLayout>

    </com.absolute.android.notescentral.models.views.InterceptorLinearLayout>

    <include
            android:id="@+id/undobar"
            layout="@layout/undobar"/>




    <ImageView
            android:id="@+id/expanded_image"
            android:layout_width="match_parent"
            android:scaleType="centerCrop"
            android:layout_height="match_parent"/>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:id="@+id/snackbar_placeholder"
            android:layout_gravity="bottom"/>


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.bottomappbar.BottomAppBar
            android:id="@+id/bottom_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:backgroundTint="?attr/somaElev"
            app:elevation="8dp"
            wheel:fabCradleVerticalOffset="10dp"

            app:fabAlignmentMode="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/checkopen"
                    android:padding="4dp"
                    android:layout_margin="9dp"
                    android:background="@drawable/rounded_ripple"
                    android:tint="?attr/somaTextS"
                    android:src="@drawable/checklist"/>
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:id="@+id/draw"
                    android:layout_margin="9dp"
                    android:background="@drawable/rounded_ripple"
                    android:tint="?attr/somaTextS"
                    android:src="@drawable/ic_brush_black_24dp"/>
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/addcam"
                    android:padding="4dp"
                    android:layout_margin="9dp"
                    android:background="@drawable/rounded_ripple"
                    android:tint="?attr/somaTextS"
                    android:src="@drawable/camera"/>
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/audio"
                    android:padding="4dp"
                    android:layout_margin="9dp"
                    android:background="@drawable/rounded_ripple"
                    android:tint="?attr/somaTextS"
                    android:src="@drawable/ic_mic_black_24dp"/>
            </LinearLayout>

        </com.google.android.material.bottomappbar.BottomAppBar>


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_anchor="@id/bottom_app_bar"
            wheel:layout_anchorGravity="bottom|end"
            app:tint="@null"
            android:clickable="true"
            android:focusable="true"
            app:backgroundTint="?attr/somaPrimary"
            app:maxImageSize="30dp"
            app:fabCustomSize="64dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Soma.Fab"
            android:src="@drawable/cusotmcreate"
            app:elevation="6dp"
            app:useCompatPadding="true" />




    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.pnikosis.materialishprogress.ProgressWheel
        android:id="@+id/progress_wheel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
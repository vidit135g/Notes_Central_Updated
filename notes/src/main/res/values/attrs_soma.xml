<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Design tokens beyond the standard Material colour roles. Both themes
      (styles_soma.xml) set every one of these; layouts and drawables reference
      them as ?attr/somaXxx and never a raw @color, so the whole app re-skins
      when the theme changes.

      Adding a token here means adding it to BOTH theme blocks — a token set in
      only one resolves to nothing in the other and paints transparent.
    -->
    <attr name="somaBg" format="color" />
    <attr name="somaElev" format="color" />
    <attr name="somaSurf" format="color" />
    <attr name="somaMuted" format="color" />
    <attr name="somaStrong" format="color" />
    <attr name="somaTextP" format="color" />
    <attr name="somaTextS" format="color" />
    <attr name="somaTextM" format="color" />
    <attr name="somaBorder" format="color" />
    <attr name="somaBorderSub" format="color" />
    <attr name="somaPrimary" format="color" />
    <attr name="somaPrimaryPressed" format="color" />
    <attr name="somaSecondary" format="color" />
    <attr name="somaAccent" format="color" />

    <!-- Text/icon colour for anything sitting ON somaPrimary. The cyan fill is
         light in both themes, so this stays near-black in both — never flip it
         to white on dark. somaOnFillSub is its secondary-text partner. -->
    <attr name="somaOnFill" format="color" />
    <attr name="somaOnFillSub" format="color" />

    <!-- Cyan is a fill, not a text colour — it fails contrast as text on both
         grounds. Anything that must *read* as the accent (links, the "forgot
         passcode" affordance) uses this darker/lighter sibling instead. -->
    <attr name="somaLink" format="color" />

    <!-- The raised pill: active filter chip, primary button, floating action
         bar. Dark-on-light in the light theme, light-on-dark in the dark one,
         so it always reads as lifted off the page. -->
    <attr name="somaInk" format="color" />
    <attr name="somaInkSoft" format="color" />
    <attr name="somaOnInk" format="color" />

    <!-- Completed checklist item / checked checkbox. -->
    <attr name="somaDone" format="color" />

    <!-- Overdue reminders and destructive actions. -->
    <attr name="somaDanger" format="color" />
    <attr name="somaDangerBg" format="color" />

    <!-- Search-result and in-note text highlight. -->
    <attr name="somaHighlight" format="color" />
    <attr name="somaHighlightInk" format="color" />

    <!-- Folder tints. Each pair is a fill plus the ink that reads on it; the
         "Stroke" suffix is historical — these are text colours, not outlines. -->
    <attr name="somaTileCalm" format="color" />
    <attr name="somaTileCalmStroke" format="color" />
    <attr name="somaTileWarm" format="color" />
    <attr name="somaTileWarmStroke" format="color" />
</resources>

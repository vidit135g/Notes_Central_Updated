<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Wordsy palette. Replaces the six dosha-period palettes that used to live
      here: the app now ships one light look and one dark one, and the theme
      attrs in attrs_soma.xml are the only thing layouts ever reference, so the
      whole UI re-skins from the two blocks in styles_soma.xml.

      The `soma_` prefix is kept throughout. Renaming it would touch ~60 layouts
      and every drawable for no visual gain; the names are the API, the values
      are what changed.
    -->

    <!-- ===================== LIGHT ===================== -->

    <!-- Grounds. White page, one grey card surface. Note cards, chips and
         grouped setting rows all sit on `surf`; `muted` is the one step darker
         used for a card that must read as *inert* (a locked note). -->
    <color name="soma_light_bg">#FFFFFF</color>
    <color name="soma_light_elev">#FFFFFF</color>
    <color name="soma_light_surf">#F1F1F4</color>
    <color name="soma_light_muted">#E8E8ED</color>
    <color name="soma_light_strong">#D6D6DE</color>

    <!-- Text. textM is the lightest that still clears 4.5:1 on both #FFFFFF
         and #F1F1F4 — anything lighter fails on the card surface, which is
         where most secondary text actually sits. -->
    <color name="soma_light_textP">#15151A</color>
    <color name="soma_light_textS">#4A4A53</color>
    <color name="soma_light_textM">#6B6B74</color>

    <color name="soma_light_border">#E0E0E7</color>
    <color name="soma_light_borderSub">#EDEDF1</color>

    <!-- Accent. The cyan is a *fill*, never a text colour: at 4.5:1 it fails on
         white, so every label on it uses onFill (near-black) instead, and cyan
         text on white is replaced by somaLink. -->
    <color name="soma_light_primary">#51C9F2</color>
    <color name="soma_light_primaryPressed">#35B5E0</color>
    <color name="soma_light_secondary">#A824C0</color>
    <color name="soma_light_accent">#51C9F2</color>
    <color name="soma_light_onFill">#0B1E26</color>
    <color name="soma_light_onFillSub">#0E3A49</color>
    <color name="soma_light_link">#0E7FA6</color>

    <!-- Ink: the dark pill used for the active chip, the primary button and the
         floating action bar. -->
    <color name="soma_light_ink">#1B1B20</color>
    <color name="soma_light_inkSoft">#26262C</color>
    <color name="soma_light_onInk">#FFFFFF</color>

    <color name="soma_light_done">#0FB184</color>
    <color name="soma_light_danger">#A83926</color>
    <color name="soma_light_dangerBg">#FCE8E4</color>
    <color name="soma_light_highlight">#F0D9FB</color>
    <color name="soma_light_highlightInk">#6C1990</color>

    <!-- Folder tints. Paired bg/ink, each pair checked at 4.5:1. -->
    <color name="soma_light_tileCalm">#CFF0FC</color>
    <color name="soma_light_tileCalmStroke">#0B3D52</color>
    <color name="soma_light_tileWarm">#F2E3FA</color>
    <color name="soma_light_tileWarmStroke">#6C1990</color>

    <!-- ===================== DARK ===================== -->

    <!-- Not an inversion: the grounds are warm-neutral near-blacks so the cyan
         keeps its chroma, and the card step is *up* from the page rather than
         down, which is what the light side does in reverse. -->
    <color name="soma_dark_bg">#0F0F13</color>
    <color name="soma_dark_elev">#16161B</color>
    <color name="soma_dark_surf">#1A1A21</color>
    <color name="soma_dark_muted">#23232B</color>
    <color name="soma_dark_strong">#2A2A33</color>

    <color name="soma_dark_textP">#F4F4F7</color>
    <color name="soma_dark_textS">#C2C2CC</color>
    <color name="soma_dark_textM">#9A9AA6</color>

    <color name="soma_dark_border">#2A2A33</color>
    <color name="soma_dark_borderSub">#23232B</color>

    <!-- The cyan is unchanged across themes on purpose: it is the brand mark,
         and it reads at 4.5:1+ against both grounds as a fill. -->
    <color name="soma_dark_primary">#51C9F2</color>
    <color name="soma_dark_primaryPressed">#35B5E0</color>
    <color name="soma_dark_secondary">#D06BE8</color>
    <color name="soma_dark_accent">#51C9F2</color>
    <color name="soma_dark_onFill">#0B1E26</color>
    <color name="soma_dark_onFillSub">#0E3A49</color>
    <color name="soma_dark_link">#7FD9F6</color>

    <!-- On dark, "ink" inverts its job: the raised pill is a step *lighter*
         than the page, not darker. -->
    <color name="soma_dark_ink">#23232B</color>
    <color name="soma_dark_inkSoft">#2E2E38</color>
    <color name="soma_dark_onInk">#FFFFFF</color>

    <color name="soma_dark_done">#0FB184</color>
    <color name="soma_dark_danger">#F08D78</color>
    <color name="soma_dark_dangerBg">#39201B</color>
    <color name="soma_dark_highlight">#3A1A48</color>
    <color name="soma_dark_highlightInk">#E9B8F7</color>

    <color name="soma_dark_tileCalm">#0E3445</color>
    <color name="soma_dark_tileCalmStroke">#A5E4F8</color>
    <color name="soma_dark_tileWarm">#331343</color>
    <color name="soma_dark_tileWarmStroke">#E2A8F2</color>

    <!-- Splash. Fixed, not themed: the system splash is drawn before any
         Activity (and so before the theme) exists. -->
    <color name="soma_splash_bg">#51C9F2</color>

    <!-- Onboarding only. The purple ground is the one screen that is neither
         light nor dark — it is the same in both themes, as in the reference. -->
    <color name="soma_intro_bg">#B42BF0</color>
    <color name="soma_intro_bubble">#1AFFFFFF</color>
    <color name="soma_intro_card">#51C9F2</color>
    <color name="soma_intro_ink">#0B1E26</color>
</resources>
